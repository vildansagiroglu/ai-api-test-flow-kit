          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json();",
                  "pm.test(\"Body is a non-empty array\", () => {",
                  "    pm.expect(ids).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "pm.test(\"Every item has a numeric bookingid\", () => {",
