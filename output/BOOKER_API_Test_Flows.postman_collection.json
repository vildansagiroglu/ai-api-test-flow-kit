                  "});",
                  "pm.collectionVariables.set(\"readBookingId\", ids[0].bookingid);",
                  "pm.test(\"Response time < 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        },
        {
          "name": "BOOKER | Booking | Get booking by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/booking/{{readBookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Other users of the public API can delete bookings at any time: a 404 here means data instability.",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Key fields exist\", () => {",
                  "    [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"].forEach(k => pm.expect(b).to.have.property(k));",
                  "    pm.expect(b.bookingdates).to.have.property(\"checkin\");",
                  "    pm.expect(b.bookingdates).to.have.property(\"checkout\");",
                  "});",
                  "pm.test(\"Response time < 5000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
        }
